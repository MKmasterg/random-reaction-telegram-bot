# Required: create a development bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=replace-with-development-bot-token

# polling (local default) or webhook
BOT_TRANSPORT=polling

REPLY_PROBABILITY=0.02
GROUP_COOLDOWN=5m
PORT=8080

# Required only when BOT_TRANSPORT=webhook.
PUBLIC_BASE_URL=
WEBHOOK_SECRET=
